DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Execution mode is stored in the database and shown in the UI as DEMO or LIVE SOLARI.
# Live mode never silently falls back to demo.

# Required only for LIVE SOLARI mode.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com

# Public URL of this app so Solari Browser can open the demo portal.
PORTALPILOT_PORTAL_URL=

# Optional. Used only for bounded requirement extraction. Output is Zod-validated.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional persistent execution worker mode. When true, checks are enqueued for `npm run worker`.
PORTALPILOT_ASYNC=false
PORTALPILOT_WORKER_BATCH=5

# Optional authenticated Solari browser profile for portal sessions. Treat profile IDs as sensitive.
SOLARI_PROFILE_ID=
